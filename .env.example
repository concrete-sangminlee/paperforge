# Database
DATABASE_URL=postgresql://paperforge:paperforge@localhost:5432/paperforge?connection_limit=5

# Redis
REDIS_URL=redis://localhost:6379
# Alternative host/port form when a full URL is not available.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# If true, rate-limited endpoints fail closed when Redis is unavailable.
# Leave false for local/dev and Vercel deployments without Redis; an in-memory fallback is used.
RATE_LIMIT_STRICT=false

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=paperforge
MINIO_SECRET_KEY=paperforge123
MINIO_BUCKET=paperforge
# When true, file operations fall back to DB / local FS if MinIO is unavailable
# (used by Vercel deploys without object storage). Set false to require MinIO.
MINIO_ALLOW_FALLBACK=true
# Optional local-disk path for the file fallback. Defaults to <cwd>/.local-storage.
LOCAL_STORAGE_PATH=

# Auth
# Auth.js v5 prefers AUTH_SECRET. NEXTAUTH_SECRET is kept as a legacy alias.
AUTH_SECRET=change-me-to-random-secret-at-least-32-chars
NEXTAUTH_SECRET=change-me-to-random-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# OAuth (optional)
# Preferred Auth.js names. Legacy GOOGLE_CLIENT_ID/GITHUB_CLIENT_ID are also supported.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@paperforge.dev
# Force TLS for SMTP. Auto-enabled when SMTP_PORT=465 even if false.
SMTP_SECURE=false

# Encryption
ENCRYPTION_KEY=change-me-to-64-hex-chars-representing-32-bytes

# MinIO SSL (set to true for production with HTTPS)
MINIO_USE_SSL=false

# WebSocket (consumed by the websocket/ service)
WS_PORT=4001
# Disconnect idle sockets after N ms (default 30 minutes). Lower for tighter cleanup.
WS_IDLE_TIMEOUT_MS=1800000

# Worker (consumed by the worker/ service)
# Max retry attempts before a compilation job is marked failed.
WORKER_MAX_ATTEMPTS=3
# How long BullMQ holds the per-job lock while compilation runs.
WORKER_LOCK_DURATION_MS=180000

# Git repository storage path
GIT_REPOS_PATH=/tmp/paperforge-repos

# AI Assistant (optional — powers the AI LaTeX assistant panel)
ANTHROPIC_API_KEY=

# Billing (optional hosted checkout; leave empty for sales-assisted checkout)
BILLING_PROVIDER=manual
BILLING_CONTACT_EMAIL=sales@paperforge.dev
BILLING_CHECKOUT_PRO_MONTHLY_URL=
BILLING_CHECKOUT_PRO_ANNUAL_URL=
BILLING_CHECKOUT_TEAM_MONTHLY_URL=
BILLING_CHECKOUT_TEAM_ANNUAL_URL=
# Payment-provider webhook signing secret. Leave empty to disable the webhook
# endpoint (it returns 503 until set). Set to your provider's endpoint secret to
# enable automated plan provisioning via POST /api/v1/billing/webhook.
BILLING_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=https://projectlatexcompiler.vercel.app
# Surfaced in /api/healthz as the running build version. Falls back to package.json version.
NEXT_PUBLIC_APP_VERSION=

# WebSocket collaboration URL (leave EMPTY or omit on Vercel — editor runs in single-user mode)
# Only set this if you have a dedicated WebSocket server running.
NEXT_PUBLIC_WS_URL=ws://localhost:4001

# CORS — comma-separated list of additional origins allowed to call the API.
# NEXT_PUBLIC_APP_URL and NEXTAUTH_URL are added automatically; only set this for extras.
CORS_ALLOWED_ORIGINS=
